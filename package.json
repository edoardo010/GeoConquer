  "description": "Geoconquer è un'app innovativa che trasforma il movimento quotidiano in un'avventura di conquista.   Correndo o camminando, gli utenti possono espandere il proprio territorio virtuale, sfidare amici e creare vere e proprie mappe di dominio personale.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "demo": "ts-node demo.ts",
    "setup:db": "ts-node src/admin/dbSetup.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "serve": "npm run build && npm start"
  },
